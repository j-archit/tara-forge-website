# Shared application configuration
ENVIRONMENT=production
DATABASE_URL=sqlite:////data/taraforge.db
VAULT_PATH=/vault
MAX_UPLOAD_BYTES=26214400
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
ALLOWED_ORIGINS=["https://taraforge.in"]
CURA_ENGINE_BINARY=CuraEngine
SLICER_DEFINITION_PATH=/app/slicing/definitions/forge_printer.json
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300

# Internal service URL used by the Next.js server only
BACKEND_URL=http://backend:8000

# Google integrations; provide the key through a mounted secret file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# Public analytics identifier
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C0HLNVX14Q
