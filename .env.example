# Shared application configuration
SITE_ADDRESS=taraforge.in
ENVIRONMENT=production
POSTGRES_DB=taraforge
POSTGRES_USER=taraforge
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
VAULT_PATH=/vault
MAX_UPLOAD_BYTES=26214400
MINIMUM_FREE_BYTES=104857600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
INTAKE_RATE_LIMIT=20
INTAKE_RATE_WINDOW_SECONDS=3600
SESSION_TTL_HOURS=12
SECURE_COOKIES=true
ALLOWED_ORIGINS=["https://taraforge.in"]
CURA_ENGINE_BINARY=CuraEngine
SLICER_DEFINITION_PATH=/app/slicing/definitions/forge_printer.json
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300

# Internal service URL used by the Next.js server only
BACKEND_URL=http://backend:8000

# Google integrations; leave blank until a read-only secret mount is configured
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# Public analytics identifier
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C0HLNVX14Q
